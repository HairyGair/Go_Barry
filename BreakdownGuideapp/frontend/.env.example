VITE_SUPABASE_URL=https://oieliubbvvdzhzvikzal.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9pZWxpdWJidnZkemh6dmlremFsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU1NTA5OTUsImV4cCI6MjA3MTEyNjk5NX0.L0qUXBFOnzxoXt-ChhMAW8zqgprUXFdvqR2dxJ1GTU8

# ==========================================
# API CONFIGURATION
# ==========================================
# Backend API endpoint
VITE_API_URL=https://breakdown-guide.onrender.com
VITE_API_BASE_URL=http://localhost:5000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000

# App URLs
VITE_APP_URL=https://breakdowns.gobarry.co.uk

# ==========================================
# AUTHENTICATION
# ==========================================
# Authentication settings
VITE_ENABLE_AUTH=true
VITE_SESSION_TIMEOUT=3600
VITE_REFRESH_TOKEN_INTERVAL=1800

# ==========================================
# WEBSOCKET CONFIGURATION
# ==========================================
# Real-time updates
VITE_WS_URL=ws://localhost:5000
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_MAINTENANCE_MODE=false

# ==========================================
# MAP CONFIGURATION
# ==========================================
# Mapping service configuration
VITE_MAP_PROVIDER=openstreetmap
VITE_MAP_API_KEY=
VITE_MAP_DEFAULT_LAT=54.9783
VITE_MAP_DEFAULT_LNG=-1.6178
VITE_MAP_DEFAULT_ZOOM=10

# Google Maps API for Location Services (ALREADY CONFIGURED)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the "Geocoding API" for your project
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ==========================================
# ANALYTICS
# ==========================================
# Analytics service configuration
VITE_GA_MEASUREMENT_ID=
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=

# ==========================================
# STORAGE
# ==========================================
# File storage configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
VITE_STORAGE_BUCKET=breakdown-photos

# ==========================================
# NOTIFICATIONS
# ==========================================
# Push notification configuration
VITE_VAPID_PUBLIC_KEY=
VITE_NOTIFICATION_POLLING_INTERVAL=30000

# ==========================================
# ENVIRONMENT
# ==========================================
# Environment settings
VITE_ENV=development
VITE_APP_NAME="GNE Breakdown Management"
VITE_APP_VERSION=1.5.4
VITE_BUILD_NUMBER=
VITE_COMMIT_SHA=

# ==========================================
# PERFORMANCE
# ==========================================
# Performance optimization
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_TTL=3600
VITE_STALE_WHILE_REVALIDATE=86400

# ==========================================
# SECURITY
# ==========================================
# Security settings
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_SECURE_COOKIES=false

# ==========================================
# THIRD PARTY SERVICES
# ==========================================
# External service integrations
VITE_WEATHER_API_KEY=
VITE_TRAFFIC_API_KEY=
VITE_FLEET_TRACKING_API_KEY=

# ==========================================
# DEVELOPMENT
# ==========================================
# Development only settings
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_HMR_PORT=5173
VITE_HMR_HOST=localhost

# ==========================================
# TESTING
# ==========================================
# Testing configuration
VITE_TEST_MODE=false
VITE_TEST_USER_EMAIL=test.supervisor@gonortheast.co.uk
VITE_TEST_USER_PASSWORD=test_password_123

# ==========================================
# DEPLOYMENT
# ==========================================
# Deployment configuration
VITE_PUBLIC_URL=https://breakdowns.gobarry.co.uk
VITE_CDN_URL=
VITE_ASSET_PREFIX=