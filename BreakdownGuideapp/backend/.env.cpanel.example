# =============================================================================
# Go BARRY Backend - cPanel Production Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# Security: NEVER commit .env with actual credentials to git
#
# Last Updated: October 2025
# Platform: cPanel Shared/Dedicated Hosting
# Node.js: 18+
# Database: MySQL 8.0+
# =============================================================================

# =============================================================================
# NODE.JS ENVIRONMENT
# =============================================================================
NODE_ENV=production
PORT=3001

# Memory limits for shared hosting (512MB-1GB RAM)
# Uncomment and adjust based on your hosting tier:
# NODE_OPTIONS=--max-old-space-size=512   # Shared hosting (512MB)
# NODE_OPTIONS=--max-old-space-size=1024  # Dedicated/VPS (1GB+)

# Disable experimental features if experiencing WebAssembly errors
# NODE_OPTIONS=--no-experimental-fetch --max-old-space-size=512

# =============================================================================
# MySQL DATABASE CONFIGURATION (Primary - Required)
# =============================================================================
# Your cPanel MySQL database credentials
# Format: cpanel_username_dbname (e.g., gobarryco_breakdown)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_username_breakdown
DB_USER=your_cpanel_username_dbuser
DB_PASSWORD=your_secure_mysql_password

# Connection pool settings (adjust based on hosting tier)
# Shared hosting: 3-5 connections
# Dedicated/VPS: 10-20 connections
MYSQL_CONNECTION_LIMIT=10

# Alternative variable names (for compatibility)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_cpanel_username_breakdown
MYSQL_USER=your_cpanel_username_dbuser
MYSQL_PASSWORD=your_secure_mysql_password

# =============================================================================
# SECURITY CONFIGURATION (Critical - Change All Defaults!)
# =============================================================================

# JWT Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_CHANGE_IN_PRODUCTION_generate_64_chars
JWT_EXPIRATION=24h

# Session Secret
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_CHANGE_IN_PRODUCTION_generate_32_chars

# Cookie Configuration
COOKIE_DOMAIN=.gobarry.co.uk
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL (your production domain)
API_BASE_URL=https://breakdowns.gobarry.co.uk/api

# Frontend App URL
APP_URL=https://breakdowns.gobarry.co.uk

# CORS Origins (comma-separated, no spaces)
# Include all domains that need to access your API
ALLOWED_ORIGINS=https://gobarry.co.uk,https://www.gobarry.co.uk,https://breakdowns.gobarry.co.uk

# Development origins (remove in production)
# ALLOWED_ORIGINS=https://breakdowns.gobarry.co.uk,http://localhost:5173,http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================

# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# Login rate limiting (stricter)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX_REQUESTS=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable authentication (should be true in production)
ENABLE_AUTH=true

# Enable mock data (should be false in production)
ENABLE_MOCK_DATA=false

# Enable WebSocket real-time features
ENABLE_WEBSOCKET=true

# Enable activity logging
ENABLE_ACTIVITY_LOGGING=true

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket URL (typically same as API but with wss:// protocol)
WEBSOCKET_URL=wss://breakdowns.gobarry.co.uk/ws

# WebSocket heartbeat interval (milliseconds)
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# WebSocket connection timeout (milliseconds)
WEBSOCKET_TIMEOUT=60000

# Maximum concurrent WebSocket connections
WEBSOCKET_MAX_CONNECTIONS=50

# =============================================================================
# EXTERNAL API KEYS (Optional - Leave commented if not using)
# =============================================================================

# TomTom Traffic API (Traffic flow data)
# Free tier: 2,500 requests/day
# Sign up: https://developer.tomtom.com/
# TOMTOM_API_KEY=your_tomtom_api_key_here

# HERE Maps API (Geocoding and routing)
# Free tier: 250,000 transactions/month
# Sign up: https://developer.here.com/
# HERE_API_KEY=your_here_api_key_here

# Google Maps API (Geocoding fallback)
# Free tier: $200 credit/month (28,000 requests)
# Sign up: https://console.cloud.google.com/
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap API (Weather data)
# Free tier: 1,000 calls/day
# Sign up: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# =============================================================================
# TRAFFIC DATA SOURCES (Optional)
# =============================================================================

# National Highways API (Motorway incidents - M1, A1(M), etc.)
# Free, but requires registration
# Sign up: https://webtris.highwaysengland.co.uk/
# NATIONAL_HIGHWAYS_API_KEY=your_national_highways_api_key

# Street Manager API (Roadworks data)
# Free for local authorities
# Sign up: https://www.gov.uk/guidance/street-manager
# STREETMANAGER_API_KEY=your_street_manager_api_key
# STREETMANAGER_WEBHOOK_SECRET=your_webhook_secret_for_validation

# One.Network API (Alternative roadworks source)
# FREE_TIER_AVAILABLE=true
# ONENETWORK_API_KEY=your_onenetwork_api_key

# SCOOT Traffic API (Traffic signal data)
# Requires TfL/local authority access
# SCOOT_API_KEY=your_scoot_api_key

# Elgin Roadworks API (Local roadworks)
# ELGIN_API_KEY=your_elgin_api_key

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log to file (true/false)
LOG_TO_FILE=true

# Log file path (relative to backend directory)
LOG_FILE_PATH=./logs/app.log

# Maximum log file size (in bytes)
LOG_MAX_SIZE=10485760

# Maximum number of log files to keep
LOG_MAX_FILES=5

# =============================================================================
# EMAIL CONFIGURATION (Optional - For notifications)
# =============================================================================

# SMTP settings for sending email notifications
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_specific_password
# EMAIL_FROM=Go BARRY <noreply@gobarry.co.uk>

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================

# Sentry Error Tracking
# FREE_TIER_AVAILABLE=true (5,000 events/month)
# SENTRY_DSN=your_sentry_dsn_here

# Application Insights / Custom Analytics
# ANALYTICS_ENABLED=false
# ANALYTICS_KEY=your_analytics_key

# =============================================================================
# BACKUP & MAINTENANCE (Optional)
# =============================================================================

# Automatic backup enabled
ENABLE_AUTO_BACKUP=false

# Backup schedule (cron format: "0 2 * * *" = 2 AM daily)
# BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# LEGACY SUPABASE CONFIGURATION (For Reference Only - DO NOT USE)
# =============================================================================
# These were used in previous version. Kept for migration reference.
# System now uses MySQL exclusively - Supabase dependency removed.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# REQUIRED BEFORE DEPLOYMENT:
# 1. Generate new JWT_SECRET (64 random characters)
# 2. Generate new SESSION_SECRET (32 random characters)
# 3. Set strong DB_PASSWORD (from cPanel MySQL)
# 4. Update DB_NAME, DB_USER with your cPanel username prefix
# 5. Update ALLOWED_ORIGINS with your production domain(s)
# 6. Set ENABLE_AUTH=true and ENABLE_MOCK_DATA=false
# 7. Configure NODE_OPTIONS based on your hosting tier
#
# OPTIONAL (Configure if needed):
# 8. Add external API keys (TomTom, HERE, etc.) for enhanced features
# 9. Configure email settings for notifications
# 10. Enable monitoring/analytics integrations
#
# SECURITY CHECKLIST:
# ✓ All secrets generated (JWT_SECRET, SESSION_SECRET)
# ✓ Strong MySQL password set
# ✓ .env added to .gitignore
# ✓ CORS origins restricted to production domains only
# ✓ ENABLE_MOCK_DATA=false in production
# ✓ Rate limiting configured appropriately
#
# MEMORY OPTIMIZATION (Shared Hosting):
# - Use MYSQL_CONNECTION_LIMIT=3-5 (not 10)
# - Set NODE_OPTIONS=--max-old-space-size=512
# - Enable lazy loading where possible
#
# PRODUCTION URLS:
# Frontend: https://breakdowns.gobarry.co.uk
# Backend API: https://breakdowns.gobarry.co.uk/api
# WebSocket: wss://breakdowns.gobarry.co.uk/ws
# Health Check: https://breakdowns.gobarry.co.uk/api/health
#
# =============================================================================
# END OF CONFIGURATION
# =============================================================================
