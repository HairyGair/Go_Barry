# =============================================================================
# Go BARRY Breakdown Management System
# Environment Configuration Template
# Database: MySQL (cPanel)
# Authentication: JWT + bcrypt
# Last Updated: October 27, 2025
# =============================================================================

# Environment Configuration
NODE_ENV=development
PORT=3001

# Node.js Options (for shared hosting with limited memory)
# Uncomment if experiencing WebAssembly memory errors
# NODE_OPTIONS=--no-experimental-fetch
# NODE_OPTIONS=--no-experimental-fetch --max-old-space-size=512

# =============================================================================
# DATABASE CONFIGURATION - MySQL (cPanel Hosting)
# =============================================================================
# Required: MySQL connection credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gobarryco_breakdowns
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Optional: Connection pool settings (defaults shown)
MYSQL_CONNECTION_LIMIT=10

# =============================================================================
# LEGACY SUPABASE CONFIGURATION (NO LONGER USED)
# =============================================================================
# System migrated to MySQL (October 2025)
# These variables are kept for reference only - DO NOT USE
#
# SUPABASE_URL=https://oieliubbvvdzhzvikzal.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL
API_BASE_URL=https://breakdowns.gobarry.co.uk/api

# Frontend App URL
APP_URL=https://breakdowns.gobarry.co.uk

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://breakdowns.gobarry.co.uk

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Secret (generate a random string for production)
SESSION_SECRET=your_session_secret_here_change_in_production

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AUTH=false
ENABLE_MOCK_DATA=true

# =============================================================================
# INTEGRATION APIS (Optional)
# =============================================================================
# TomTom Traffic API
# TOMTOM_API_KEY=your_tomtom_api_key

# HERE Maps API
# HERE_API_KEY=your_here_api_key

# National Highways API
# NATIONAL_HIGHWAYS_API_KEY=your_api_key
