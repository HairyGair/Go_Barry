# Files to exclude when deploying to cPanel

# Dependencies
node_modules/
npm-debug.log
yarn-error.log

# Environment files (create manually on server)
.env
.env.local
.env.development

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Test files
*.test.js
__tests__/
coverage/

# Documentation (optional - keep if you want docs on server)
# *.md

# Backup files
*.backup
*.bak
*.supabase.backup

# Temporary files
tmp/
temp/
*.tmp
