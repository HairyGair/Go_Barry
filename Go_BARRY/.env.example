# Frontend Environment Variables for Go BARRY
# Copy this file to .env and configure with your values

# Backend API Configuration
# URL of the Go BARRY backend server
EXPO_PUBLIC_API_BASE_URL=https://go-barry.onrender.com

# API request timeout in milliseconds (default: 10 seconds)
EXPO_PUBLIC_API_TIMEOUT=10000

# Google Maps API Configuration
# API key for geocoding, static maps and the embedded map view.
#
# REQUIRED. There is no hardcoded fallback in the code, on purpose: this repo is
# public, so a committed key gets scraped and billed against the account. If this
# is unset, map features degrade gracefully instead of loading a broken map.
#
# The key MUST be restricted in the Cloud console before use:
#   - Application restrictions: HTTP referrers, limited to gobarry.co.uk
#   - API restrictions: Geocoding API, Maps JavaScript API, Maps Embed API,
#     Maps Static API only. Do not leave Places enabled.
#
# This value is inlined into the web bundle at build time, so it is public by
# design. Referrer restrictions are what protect it, not secrecy.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Development Settings (Optional)
# Uncomment for local development
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Production Settings (Optional)
# EXPO_PUBLIC_API_BASE_URL=https://api.gobarry.co.uk
