# Frontend Environment Variables for Go BARRY
# Copy this file to .env and configure with your values

# Backend API Configuration
# URL of the Go BARRY backend server
EXPO_PUBLIC_API_BASE_URL=https://go-barry.onrender.com

# API request timeout in milliseconds (default: 10 seconds)
EXPO_PUBLIC_API_TIMEOUT=10000

# Google Maps API Configuration
# API key for geocoding and location services
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Development Settings (Optional)
# Uncomment for local development
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Production Settings (Optional)
# EXPO_PUBLIC_API_BASE_URL=https://api.gobarry.co.uk
