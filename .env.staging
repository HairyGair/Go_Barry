# Go BARRY Roadworks Manager V2 - Staging Environment Variables
# © 2024-2025 Anthony Gair. All rights reserved.

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
SUPABASE_URL=your_staging_supabase_project_url
SUPABASE_ANON_KEY=your_staging_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_supabase_service_role_key

# =============================================================================
# GEOCODING SERVICES (Optional but recommended)
# =============================================================================
TOMTOM_API_KEY=your_tomtom_api_key

# =============================================================================
# EMAIL SERVICES (Test configuration)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@gobarry.co.uk
SMTP_PASS=your_staging_app_password
SMTP_FROM=staging-no-reply@gobarry.co.uk

# =============================================================================
# REPORT RECIPIENTS (Staging - limited recipients)
# =============================================================================
REPORT_RECIPIENTS=anthony.gair@gobarry.co.uk
WEEKLY_REPORT_RECIPIENTS=anthony.gair@gobarry.co.uk
ADMIN_EMAIL=anthony.gair@gobarry.co.uk

# =============================================================================
# ACCESS CONTROL
# =============================================================================
ADMIN_SUPERVISORS=AG003,BP009
CONTROLLER_BADGES=CTRL001,CTRL002,CTRL003

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
NODE_ENV=staging
PORT=3001
SESSION_SECRET=staging_session_secret_change_in_production
API_RATE_LIMIT=200
CACHE_TTL_MINUTES=60

# =============================================================================
# LOGGING AND MONITORING (Enhanced for testing)
# =============================================================================
LOG_LEVEL=debug
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DEBUG_LOGS=true

# =============================================================================
# FRONTEND CONFIGURATION (EXPO_PUBLIC_*)
# =============================================================================
EXPO_PUBLIC_SUPABASE_URL=your_staging_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_staging_supabase_anon_key
EXPO_PUBLIC_API_BASE_URL=https://go-barry-staging.onrender.com
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_DEBUG_MODE=true

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# Street Manager API (staging/test endpoints)
STREET_MANAGER_API_KEY=your_street_manager_test_api_key
STREET_MANAGER_BASE_URL=https://test-api.streetmanager.co.uk

# Nominatim fallback geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# =============================================================================
# SECURITY SETTINGS (Relaxed for staging)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,https://go-barry-staging.onrender.com
JWT_SECRET=staging_jwt_secret_change_in_production
BCRYPT_ROUNDS=10

# =============================================================================
# PERFORMANCE SETTINGS (Lower limits for staging)
# =============================================================================
MAX_MEMORY_MB=1500
GC_INTERVAL_MS=60000
CLEANUP_INTERVAL_HOURS=6