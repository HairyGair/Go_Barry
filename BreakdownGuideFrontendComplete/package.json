{
  "name": "breakdown-guide-frontend",
  "version": "2.0.0",
  "description": "Optimized Frontend for Go North East Breakdown Guide System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:legacy": "vite build --mode legacy",
    "build:modern": "vite build --mode modern",
    "preview": "vite preview",
    "analyze": "vite-bundle-analyzer dist/assets/*.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "playwright test",
    "serve": "serve dist -p 3001"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-legacy": "^5.3.1",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-bundle-analyzer": "^0.7.0",
    "terser": "^5.19.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "serve": "^14.2.1",
    "@playwright/test": "^1.42.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Anthony Gair",
  "license": "PROPRIETARY"
}