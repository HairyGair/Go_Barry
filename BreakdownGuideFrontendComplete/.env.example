# Go North East Breakdown Guide - Environment Configuration

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server Configuration
PORT=3002
NODE_ENV=production

# API Configuration
API_BASE_URL=http://localhost:3002
MAIN_BACKEND_URL=https://go-barry.onrender.com

# CORS Configuration
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Security
SESSION_SECRET=your_session_secret_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Supervisor Badges (comma-separated)
AUTHORIZED_SUPERVISORS=AW001,AC002,AG003,CF004,DH005,JD006,JP007,SG008,BP009
ADMIN_SUPERVISORS=AG003,BP009

# Features
ENABLE_BREAKDOWN_TRACKER=true
ENABLE_PATTERN_DETECTION=true
ENABLE_AUTO_ESCALATION=true
ENABLE_PASSENGER_CLOUD_INTEGRATION=false

# Maintenance
DAILY_RESET_HOUR=1
ARCHIVE_DAYS=30
