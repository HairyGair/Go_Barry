{
  "name": "go-barry-backend",
  "version": "1.0.0",
  "description": "Go BARRY Traffic Intelligence Backend - Real-time traffic monitoring and alert management",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=1800 --expose-gc render-startup.js",
    "start-production": "node --max-old-space-size=1800 --expose-gc index.js",
    "start-development": "node index.js",
    "dev": "nodemon index.js",
    "postinstall": "node scripts/install-chrome.js || true",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:integration": "node test-integration.js",
    "test:roadworks": "node --test tests/roadworks.test.js",
    "test:supabase": "node tests/supabaseConnectionTest.js",
    "fix-redis": "node fix-redis-dependency.js",
    "install-redis": "npm install redis && echo '✅ Redis installed successfully'",
    "test:communications": "node backend/tests/communications/run-tests.js",
    "test:communications:unit": "npx mocha backend/tests/communications/unit.test.js",
    "test:communications:integration": "npx mocha backend/tests/communications/integration.test.js --timeout 60000",
    "health": "curl http://localhost:3001/api/health || echo 'Server not running'",
    "alerts": "curl http://localhost:3001/api/alerts | jq '.alerts | length' || echo 'No alerts or jq not installed'",
    "memory-check": "node -e \"console.log('Node.js Memory Limits:'); console.log('Max Old Space:', v8.getHeapStatistics().heap_size_limit / 1024 / 1024, 'MB'); console.log('Available Memory:', process.memoryUsage());\"",
    "memory-test": "node --max-old-space-size=2048 --expose-gc -e \"console.log('Memory test passed - 2GB heap available'); if(global.gc) console.log('Garbage collection available'); else console.log('Warning: Garbage collection not available');\"",
    "migrate:supabase": "node migrate-to-supabase.js",
    "scrape:onenetwork": "node runOneNetworkScraper.js"
  },
  "dependencies": {
    "@azure/identity": "^4.10.1",
    "@azure/msal-node": "^3.6.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.50.2",
    "@turf/turf": "^6.5.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.0",
    "convex": "^1.24.8",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.4",
    "p-retry": "^6.2.1",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "proj4": "^2.19.10",
    "puppeteer": "^24.10.2",
    "redis": "^4.7.1",
    "ws": "^8.18.2",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "sinon": "^15.2.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "traffic",
    "alerts",
    "barry",
    "go-north-east",
    "transport"
  ],
  "author": "Anthony Gair <anthonygair@icloud.com>",
  "license": "PROPRIETARY",
  "copyright": "© 2024-2025 Anthony Gair. All rights reserved.",
  "repository": {
    "type": "git",
    "url": "your-repo-url"
  }
}
