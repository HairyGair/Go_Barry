# Go BARRY Supervisor Logging Configuration
# Environment variables for production supervisor action logging system

# =====================================
# CORE ACTIVATION SETTINGS
# =====================================

# Enable/disable supervisor logging globally
# Default: true (enabled)
SUPERVISOR_LOGGING_ENABLED=true

# Automatically activate logging on server startup
# Default: true (auto-activate in production, configurable in dev)
AUTO_ACTIVATE_LOGGING=true

# Force logging activation in production regardless of other settings
# Default: automatically set to true when NODE_ENV=production
# FORCE_PRODUCTION_LOGGING=true

# Enable logging in development environment
# Default: false (only activate in development if explicitly enabled)
ENABLE_DEV_LOGGING=false

# =====================================
# PERFORMANCE & MEMORY OPTIMIZATION
# =====================================

# Number of activities to batch before writing to database
# Lower values = more real-time but higher DB load
# Higher values = better performance but potential data loss on crash
# Default: 10 (optimal for 2GB RAM constraint)
LOGGING_BATCH_SIZE=10

# Timeout in milliseconds to wait before processing partial batches
# Lower values = more real-time logging
# Higher values = better batching efficiency
# Default: 5000ms (5 seconds)
LOGGING_BATCH_TIMEOUT=5000

# Maximum memory usage for logging system in MB
# Used for health monitoring and triggering cleanup
# Default: 100MB (safe for 2GB total RAM)
LOGGING_MAX_MEMORY_MB=100

# =====================================
# HEALTH MONITORING
# =====================================

# Interval in milliseconds between health checks
# Default: 60000ms (1 minute)
LOGGING_HEALTH_INTERVAL=60000

# Enable performance monitoring and metrics collection
# Default: true
ENABLE_LOGGING_PERFORMANCE=true

# =====================================
# ERROR HANDLING & RELIABILITY
# =====================================

# Number of retry attempts if logging activation fails
# Default: 3
LOGGING_RETRY_ATTEMPTS=3

# Delay in milliseconds between retry attempts
# Default: 5000ms (5 seconds)
LOGGING_RETRY_DELAY=5000

# Continue operation even if logging activation fails
# Default: true (graceful degradation)
LOGGING_GRACEFUL_DEGRADATION=true

# =====================================
# PRODUCTION DEPLOYMENT SETTINGS
# =====================================

# Enable detailed startup logging for debugging deployment issues
# Default: false (enable temporarily for troubleshooting)
DEBUG_LOGGING_STARTUP=false

# Enable health endpoint exposure for monitoring
# Default: true
EXPOSE_LOGGING_HEALTH_ENDPOINT=true

# =====================================
# RENDER.COM SPECIFIC SETTINGS
# =====================================

# These are automatically set by Render.com, but can be overridden for testing

# NODE_ENV=production
# PORT=10000

# Render automatically provides these Supabase credentials:
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key (mapped to SUPABASE_SERVICE_KEY)

# =====================================
# ADVANCED CONFIGURATION
# =====================================

# Log only specific categories (comma-separated)
# Leave empty to log all categories
# Example: authentication,alert_management,incident_management
# LOGGING_CATEGORIES_FILTER=

# Minimum priority level to log
# Options: critical, high, medium, low
# Default: medium
# LOGGING_MIN_PRIORITY=medium

# Enable request metadata collection for debugging
# Default: true
LOGGING_COLLECT_REQUEST_METADATA=true

# Enable system context collection (memory, CPU, etc.)
# Default: true
LOGGING_COLLECT_SYSTEM_CONTEXT=true

# =====================================
# EXAMPLE PRODUCTION CONFIGURATION
# =====================================

# For production deployment, use these recommended settings:
# SUPERVISOR_LOGGING_ENABLED=true
# AUTO_ACTIVATE_LOGGING=true
# LOGGING_BATCH_SIZE=15
# LOGGING_BATCH_TIMEOUT=3000
# LOGGING_MAX_MEMORY_MB=80
# LOGGING_HEALTH_INTERVAL=30000
# LOGGING_GRACEFUL_DEGRADATION=true
# ENABLE_LOGGING_PERFORMANCE=true

# =====================================
# EXAMPLE DEVELOPMENT CONFIGURATION  
# =====================================

# For development, use these settings:
# SUPERVISOR_LOGGING_ENABLED=true
# ENABLE_DEV_LOGGING=true
# AUTO_ACTIVATE_LOGGING=false
# LOGGING_BATCH_SIZE=5
# LOGGING_BATCH_TIMEOUT=1000
# DEBUG_LOGGING_STARTUP=true
# LOGGING_GRACEFUL_DEGRADATION=true