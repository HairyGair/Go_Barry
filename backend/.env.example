# Go BARRY Backend Environment Variables
# DO NOT COMMIT THIS FILE TO VERSION CONTROL

# Supabase Configuration
SUPABASE_URL=https://haountngheczrsonigbq.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# API Keys (replace with your actual keys)
TOMTOM_API_KEY=YOUR_TOMTOM_KEY_HERE
HERE_API_KEY=YOUR_HERE_KEY_HERE
MAPQUEST_API_KEY=YOUR_MAPQUEST_KEY_HERE

# Server Configuration
PORT=3001
NODE_ENV=development

# Session Configuration
SESSION_TIMEOUT_MINUTES=10

# Email Configuration (for roadwork notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Microsoft 365 OAuth (for email integration)
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_REDIRECT_URI=https://go-barry.onrender.com/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=your-tenant-id

# Communications Platform Configuration
# 8x8 VoIP Integration (Web Login)
EIGHTBYEIGHT_WEB_URL=https://apps.8x8.com/
EIGHTBYEIGHT_API_KEY=your-8x8-api-key
EIGHTBYEIGHT_CLIENT_ID=your-8x8-client-id

# SharePoint Integration
SHAREPOINT_SITE_URL=https://goaheadgroup-my.sharepoint.com/
SHAREPOINT_CLIENT_ID=your-sharepoint-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret

# Ticketer Integration (existing system)
TICKETER_API_URL=your-ticketer-api-url
TICKETER_API_KEY=your-ticketer-api-key

# Message Distribution
MESSAGE_QUEUE_REDIS_URL=redis://localhost:6379
MESSAGE_RETENTION_DAYS=30

# Optional: Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# BODS (Bus Open Data Service) Configuration
BODS_API_KEY=your-bods-api-key-here
BODS_API_URL=https://data.bus-data.dft.gov.uk/api/v1/
BODS_GNE_DATAFEED_ID=your-gne-datafeed-id-here
BODS_UPDATE_INTERVAL=10000
BODS_MAX_RETRIES=3
BODS_RATE_LIMIT_PER_HOUR=900